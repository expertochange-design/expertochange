---
import Base from './Base.astro';
import { href } from '../lib/url';
import { formatDate, otherLang, t, type Lang, type UIKey } from '../i18n/ui';
import type { Section } from '../lib/content';

interface Props {
  lang: Lang;
  section: Section;
  slug: string;
  title: string;
  summary: string;
  date: Date;
  hasTranslation: boolean;
}

const { lang, section, slug, title, summary, date, hasTranslation } = Astro.props;
const altPath = hasTranslation ? `/${section}/${slug}/` : null;
const sectionTitle = t(lang, `${section}.title` as UIKey);
---

<Base lang={lang} title={title} description={summary} altPath={altPath}>
  <article data-pagefind-body>
    <header class="article-head">
      <a class="eyebrow back" data-pagefind-meta="section" data-pagefind-ignore href={href(`/${lang}/${section}/`)}>{sectionTitle}</a>
      <h1>{title}</h1>
      <p class="lead">{summary}</p>
      <p class="meta byline" data-pagefind-ignore>
        <time datetime={date.toISOString().slice(0, 10)}>{formatDate(lang, date)}</time>
        {hasTranslation && (
          <a href={href(`/${otherLang(lang)}${altPath}`)} lang={otherLang(lang)}>{t(lang, 'common.otherLang')}</a>
        )}
      </p>
    </header>
    <slot name="before" />
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  article {
    max-width: var(--measure);
    margin-inline: auto;
  }
  .article-head {
    padding-block-end: 2rem;
    margin-block-end: 2.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .back {
    color: var(--accent);
    text-decoration: none;
  }
  .back::before {
    content: '← ';
  }
  :global(html[dir='rtl']) .back::before {
    content: '→ ';
  }
  .article-head .lead {
    margin-block: 1.25rem 1.5rem;
  }
  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
  }
  .byline a {
    text-decoration: none;
  }
</style>
