---
import { href, sitePath } from '../lib/url';
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource/vazirmatn/400.css';
import '@fontsource/vazirmatn/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import { dir, langs, otherLang, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  // Path of this page in the other language, without the language prefix.
  // Null when no translation exists yet; the switch then goes to that language's home.
  altPath?: string | null;
}

const { lang, title, description = t(lang, 'site.tagline'), altPath = null } = Astro.props;
const pageTitle = title ? `${title} · ${t(lang, 'site.name')}` : t(lang, 'site.name');
const path = sitePath(Astro.url.pathname).replace(/^\/(en|fa)/, '');
const alt = otherLang(lang);
const switchHref = href(`/${alt}${altPath ?? '/'}`);
---

<!doctype html>
<html lang={lang} dir={dir(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" hreflang={lang} href={new URL(href(`/${lang}${path}`), Astro.site)} />
    {altPath !== null && <link rel="alternate" hreflang={alt} href={new URL(href(`/${alt}${altPath}`), Astro.site)} />}
    <link rel="alternate" hreflang="x-default" href={new URL(href(`/en${lang === 'en' ? path : altPath ?? '/'}`), Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'fa' ? 'fa_IR' : 'en_US'} />
  </head>
  <body>
    <Header lang={lang} switchHref={switchHref} />
    <main>
      <slot />
    </main>
    <footer>
      <div class="inner">
        <a class="mark" href={href(`/${lang}/`)} dir="ltr">expertochange</a>
        <p class="meta">
          © {new Intl.NumberFormat(lang === 'fa' ? 'fa-IR' : 'en-US', { useGrouping: false }).format(new Date().getFullYear())} · {t(lang, 'footer.rights')}
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  footer {
    margin-block-start: 2rem;
    padding-inline: var(--gutter);
  }
  .inner {
    max-width: calc(var(--wide) - 2 * var(--gutter));
    margin-inline: auto;
    padding-block: 2.5rem 3rem;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: baseline;
    justify-content: space-between;
  }
  .mark {
    font-family: var(--serif);
    font-size: 1.05rem;
    font-style: italic;
    color: var(--ink);
    text-decoration: none;
  }
  .inner p {
    margin: 0;
  }
</style>
