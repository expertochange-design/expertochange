---
import '@fontsource-variable/inter';
import '@fontsource/vazirmatn/400.css';
import '@fontsource/vazirmatn/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import { dir, langs, otherLang, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  // Path of this page in the other language, without the language prefix.
  // Null when no translation exists yet; the switch then goes to that language's home.
  altPath?: string | null;
}

const { lang, title, description = t(lang, 'site.tagline'), altPath = null } = Astro.props;
const pageTitle = title ? `${title} · ${t(lang, 'site.name')}` : t(lang, 'site.name');
const path = Astro.url.pathname.replace(/^\/(en|fa)/, '');
const alt = otherLang(lang);
const switchHref = `/${alt}${altPath ?? '/'}`;
---

<!doctype html>
<html lang={lang} dir={dir(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" hreflang={lang} href={new URL(`/${lang}${path}`, Astro.site)} />
    {altPath !== null && <link rel="alternate" hreflang={alt} href={new URL(`/${alt}${altPath}`, Astro.site)} />}
    <link rel="alternate" hreflang="x-default" href={new URL(`/en${lang === 'en' ? path : altPath ?? '/'}`, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'fa' ? 'fa_IR' : 'en_US'} />
  </head>
  <body>
    <Header lang={lang} switchHref={switchHref} />
    <main>
      <slot />
    </main>
    <footer>
      <p>© {new Intl.NumberFormat(lang === 'fa' ? 'fa-IR' : 'en-US', { useGrouping: false }).format(new Date().getFullYear())} expertochange · {t(lang, 'footer.rights')}</p>
    </footer>
  </body>
</html>

<style>
  footer {
    border-top: 1px solid var(--line);
    padding: 1.5rem 1rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
