---
import { getImage } from 'astro:assets';
import { href, sitePath } from '../lib/url';
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource/vazirmatn/400.css';
import '@fontsource/vazirmatn/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import { dir, langs, otherLang, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  // Path of this page in the other language, without the language prefix.
  // Null when no translation exists yet; the switch then goes to that language's home.
  altPath?: string | null;
  // Picture for link previews when the page is shared; cropped to 1200×630.
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
}

const { lang, title, description = t(lang, 'site.tagline'), altPath = null, image, imageAlt, type = 'website' } = Astro.props;
const pageTitle = title ? `${title} · ${t(lang, 'site.name')}` : t(lang, 'site.name');
const path = sitePath(Astro.url.pathname).replace(/^\/(en|fa)/, '');
const alt = otherLang(lang);
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const preview = image && (await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 80 }));
// Pages without a photo fall back to the logo as a small square card.
const previewUrl = preview ? new URL(preview.src, Astro.site) : new URL(href('/apple-touch-icon.png'), Astro.site);
const switchHref = href(`/${alt}${altPath ?? '/'}`);
// Visit counting (GoatCounter: no cookies, no personal data). It feeds the
// "most popular" sort, and is only on when the site code is set at build time.
const goatcounter = import.meta.env.PUBLIC_GOATCOUNTER_CODE;
---

<!doctype html>
<html lang={lang} dir={dir(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang={lang} href={new URL(href(`/${lang}${path}`), Astro.site)} />
    {altPath !== null && <link rel="alternate" hreflang={alt} href={new URL(href(`/${alt}${altPath}`), Astro.site)} />}
    <link rel="alternate" hreflang="x-default" href={new URL(href(`/en${lang === 'en' ? path : altPath ?? '/'}`), Astro.site)} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={t(lang, 'site.name')} />
    <meta property="og:title" content={title ?? t(lang, 'site.name')} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={lang === 'fa' ? 'fa_IR' : 'en_US'} />
    <meta property="og:image" content={previewUrl} />
    {preview && <meta property="og:image:width" content="1200" />}
    {preview && <meta property="og:image:height" content="630" />}
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={preview ? 'summary_large_image' : 'summary'} />
    {goatcounter && (
      <script is:inline async data-goatcounter={`https://${goatcounter}.goatcounter.com/count`} src="https://gc.zgo.at/count.js"></script>
    )}
  </head>
  <body>
    <Header lang={lang} switchHref={switchHref} />
    <main>
      <slot />
    </main>
    <footer>
      <div class="inner">
        <a class="mark" href={href(`/${lang}/`)} dir="ltr">expertochange</a>
        <p class="meta">
          © {new Intl.NumberFormat(lang === 'fa' ? 'fa-IR' : 'en-US', { useGrouping: false }).format(new Date().getFullYear())} · {t(lang, 'footer.rights')}
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  footer {
    margin-block-start: 2rem;
    padding-inline: var(--gutter);
  }
  .inner {
    max-width: calc(var(--wide) - 2 * var(--gutter));
    margin-inline: auto;
    padding-block: 2.5rem 3rem;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: baseline;
    justify-content: space-between;
  }
  .mark {
    font-family: var(--serif);
    font-size: 1.05rem;
    font-style: italic;
    color: var(--ink);
    text-decoration: none;
  }
  .inner p {
    margin: 0;
  }
</style>
