---
// Share for one post, with a copyright reminder in the share box and a credit
// line added to text copied from the post.
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
}

const { lang, title } = Astro.props;
---

<span class="share" data-pagefind-ignore>
  <button type="button" class="share-open" aria-expanded="false" aria-controls="share-menu">
    <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 15V4M8 8l4-4 4 4M5 13v6h14v-6"></path>
    </svg>
    {t(lang, 'post.share')}
  </button>
  <div id="share-menu" class="share-menu" role="group" aria-label={t(lang, 'share.title')} hidden data-title={title} data-copied={t(lang, 'share.copied')} data-copy={t(lang, 'share.copy')}>
    <div class="share-links">
      <button type="button" class="share-copy">{t(lang, 'share.copy')}</button>
      <a data-share="telegram" target="_blank" rel="noopener">Telegram</a>
      <a data-share="whatsapp" target="_blank" rel="noopener">WhatsApp</a>
      <a data-share="linkedin" target="_blank" rel="noopener">LinkedIn</a>
      <a data-share="x" target="_blank" rel="noopener">X</a>
      <a data-share="email">{t(lang, 'share.email')}</a>
      <button type="button" class="share-native" hidden>{t(lang, 'share.more')}</button>
    </div>
    <p class="share-notice">
      <span class="share-c" aria-hidden="true">©</span>
      <span>{t(lang, 'share.notice')}</span>
    </p>
  </div>
</span>

<script>
  const menu = document.querySelector<HTMLElement>('.share-menu');
  if (menu) {
    const url = location.href.split('#')[0];
    const title = menu.dataset.title!;
    const u = encodeURIComponent(url);
    const tu = encodeURIComponent(`${title}\n${url}`);
    const targets: Record<string, string> = {
      telegram: `https://t.me/share/url?url=${u}&text=${encodeURIComponent(title)}`,
      whatsapp: `https://wa.me/?text=${tu}`,
      linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`,
      x: `https://x.com/intent/post?url=${u}&text=${encodeURIComponent(title)}`,
      email: `mailto:?subject=${encodeURIComponent(title)}&body=${u}`,
    };
    for (const a of menu.querySelectorAll<HTMLAnchorElement>('[data-share]')) a.href = targets[a.dataset.share!];

    const open = document.querySelector<HTMLButtonElement>('.share-open')!;
    const setOpen = (on: boolean) => {
      menu.hidden = !on;
      open.setAttribute('aria-expanded', String(on));
    };
    open.addEventListener('click', () => setOpen(menu.hidden));
    document.addEventListener('click', (e) => {
      if (!menu.hidden && !(e.target as Element).closest('.share')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        open.focus();
      }
    });

    const copy = menu.querySelector<HTMLButtonElement>('.share-copy')!;
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        copy.textContent = menu.dataset.copied!;
        setTimeout(() => (copy.textContent = menu.dataset.copy!), 2000);
      } catch {}
    });

    // The phone's own share sheet, where the browser has one.
    const native = menu.querySelector<HTMLButtonElement>('.share-native')!;
    if (navigator.share) {
      native.hidden = false;
      native.addEventListener('click', () => navigator.share({ title, url }).catch(() => {}));
    }
  }

  // Text copied from a post carries a credit line and a link back.
  const article = document.querySelector('article');
  const credit = document.querySelector<HTMLElement>('[data-credit]');
  article?.addEventListener('copy', (e) => {
    const text = document.getSelection()?.toString() ?? '';
    if (!text.trim() || !e.clipboardData || !credit) return;
    const url = location.href.split('#')[0];
    e.clipboardData.setData('text/plain', `${text}\n\n${credit.dataset.label}: ${url}\n© expertochange. ${credit.dataset.note}`);
    e.preventDefault();
  });
</script>

<span hidden data-credit data-label={t(lang, 'share.credit')} data-note={t(lang, 'share.creditNote')}></span>

<style>
  .share {
    position: relative;
    display: inline-flex;
  }
  .share-open {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }
  .share-open:hover,
  .share-open:focus-visible,
  .share-open[aria-expanded='true'] {
    color: var(--accent-hover);
  }
  .share-menu {
    position: absolute;
    z-index: 20;
    inset-block-start: calc(100% + 0.6rem);
    inset-inline-start: 0;
    width: min(20rem, calc(100vw - 2rem));
    padding: 0.85rem;
    border: 1px solid var(--rule-strong);
    border-radius: 3px;
    background: var(--paper-raised);
    color: var(--ink);
    box-shadow: 0 1rem 2rem rgb(0 0 0 / 0.12);
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: normal;
    text-transform: none;
  }
  .share-menu[hidden] {
    display: none;
  }
  .share-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .share-links :is(a, button) {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--rule-strong);
    border-radius: 2rem;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 0.85rem;
    text-decoration: none;
    cursor: pointer;
  }
  .share-links :is(a, button):hover,
  .share-links :is(a, button):focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }
  .share-links .share-copy {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--paper);
  }
  .share-links .share-copy:hover {
    color: var(--paper);
    background: var(--accent-hover);
  }
  .share-links [hidden] {
    display: none;
  }
  .share-notice {
    display: flex;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
    padding-block-start: 0.65rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.55;
  }
  .share-c {
    color: var(--accent);
  }
  /* On phones the menu sits at the bottom of the screen so it never runs off the edge. */
  @media (max-width: 34rem) {
    .share-menu {
      position: fixed;
      inset: auto 1rem 1rem;
      width: auto;
    }
  }
</style>
