---
import { href } from '../lib/url';
import { languages, otherLang, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  switchHref: string;
}

const { lang, switchHref } = Astro.props;
const current = Astro.url.pathname;
const links = [
  { href: href(`/${lang}/portfolio/`), label: t(lang, 'nav.portfolio') },
  { href: href(`/${lang}/books/`), label: t(lang, 'nav.books') },
  { href: href(`/${lang}/memories/`), label: t(lang, 'nav.memories') },
  { href: href(`/${lang}/about/`), label: t(lang, 'nav.about') },
];
const alt = otherLang(lang);
---

<header>
  <div class="bar">
    <a class="brand" href={href(`/${lang}/`)} dir="ltr">expertochange</a>
    <nav aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={current.startsWith(l.href) ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
      <a class="switch" href={switchHref} hreflang={alt} lang={alt}>
        {languages[alt]}
      </a>
    </nav>
  </div>
</header>

<style>
  header {
    padding-inline: var(--gutter);
  }
  .bar {
    max-width: calc(var(--wide) - 2 * var(--gutter));
    margin-inline: auto;
    padding-block: 2rem 1.4rem;
    border-bottom: 1px solid var(--ink);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: baseline;
    justify-content: space-between;
  }
  .brand {
    font-family: var(--serif);
    font-size: 1.6rem;
    font-weight: 500;
    font-style: italic;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1.6rem;
    font-family: var(--sans);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  :global(html[lang='fa']) nav {
    font-family: var(--farsi);
    font-size: 0.95rem;
    letter-spacing: 0;
  }
  nav a {
    color: var(--ink-soft);
    text-decoration: none;
    padding-block: 0.2rem;
    border-bottom: 1px solid transparent;
  }
  nav a:hover {
    color: var(--ink);
  }
  nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
  .switch {
    color: var(--accent);
    padding-inline-start: 1.6rem;
    border-inline-start: 1px solid var(--rule-strong);
    border-bottom: 0;
  }
  .switch:lang(fa) {
    font-family: var(--farsi);
    font-size: 0.95rem;
    letter-spacing: 0;
    text-transform: none;
  }
  .switch:lang(en) {
    font-family: var(--sans);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
  }
  @media (max-width: 640px) {
    .bar {
      padding-block: 1.5rem 1rem;
    }
    nav {
      gap: 0.4rem 1.1rem;
    }
    .switch {
      padding-inline-start: 1.1rem;
    }
  }
</style>
