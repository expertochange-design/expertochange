---
import LogoMark from './LogoMark.astro';
import Search from './Search.astro';
import { href } from '../lib/url';
import { languages, otherLang, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  switchHref: string;
}

const { lang, switchHref } = Astro.props;
const current = Astro.url.pathname;
const links = [
  { href: href(`/${lang}/portfolio/`), label: t(lang, 'nav.portfolio') },
  { href: href(`/${lang}/books/`), label: t(lang, 'nav.books') },
  { href: href(`/${lang}/memories/`), label: t(lang, 'nav.memories') },
  { href: href(`/${lang}/contact/`), label: t(lang, 'nav.contact') },
];
const alt = otherLang(lang);
---

<header>
  <div class="bar">
    <a class="brand" href={href(`/${lang}/`)} dir="ltr" aria-label="expertochange">
      <LogoMark class="mark" />
      <span>expertochange</span>
    </a>
    <nav aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={current.startsWith(l.href) ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
    </nav>
    <div class="tools">
      <Search lang={lang} />
      <a class="switch" href={switchHref} hreflang={alt} lang={alt}>
        {languages[alt]}
      </a>
    </div>
  </div>
</header>

<style>
  header {
    padding-inline: var(--gutter);
  }
  .bar {
    max-width: calc(var(--wide) - 2 * var(--gutter));
    margin-inline: auto;
    padding-block: 1.5rem 1rem;
    border-bottom: 1px solid var(--rule-strong);
    display: flex;
    gap: 0.5rem 1.5rem;
    align-items: center;
  }
  .brand {
    font-family: var(--serif);
    font-size: 1.6rem;
    font-weight: 500;
    font-style: italic;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    margin-inline-end: auto;
  }
  .brand :global(.mark) {
    width: 2.6rem;
    height: 2.6rem;
    color: var(--accent);
    flex: none;
    transition: transform 0.4s ease;
  }
  .brand:hover :global(.mark) {
    transform: rotate(-12deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .brand:hover :global(.mark) {
      transform: none;
    }
  }
  /* Sentence case at a readable size; every link is at least 44px tall to tap. */
  nav,
  .tools {
    display: flex;
    align-items: center;
    font-family: var(--sans);
    font-size: 0.85rem;
    font-weight: 500;
  }
  nav {
    gap: 0 0.25rem;
  }
  :global(html[lang='fa']) :is(nav, .tools) {
    font-family: var(--farsi);
    font-size: 0.95rem;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.6rem;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
    border-radius: 2px;
    box-shadow: inset 0 -2px 0 transparent;
  }
  nav a:hover {
    color: var(--ink);
  }
  nav a[aria-current='page'] {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  .tools {
    gap: 0.25rem;
    padding-inline-start: 0.75rem;
    border-inline-start: 1px solid var(--rule-strong);
  }
  .tools :global(.search-open) {
    width: 44px;
    height: 44px;
  }
  .switch {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.6rem;
    color: var(--accent);
    text-decoration: none;
  }
  .switch:lang(fa) {
    font-family: var(--farsi);
    font-size: 0.95rem;
  }
  .switch:lang(en) {
    font-family: var(--sans);
    font-size: 0.85rem;
  }
  /* Phone: logo and tools share the top row, sections fit on one row below. */
  @media (max-width: 720px) {
    .bar {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas: 'brand tools' 'nav nav';
      padding-block: 0.75rem 0;
      gap: 0.25rem 0.5rem;
    }
    .brand {
      grid-area: brand;
      font-size: 1.3rem;
      gap: 0.45rem;
    }
    .brand :global(.mark) {
      width: 2rem;
      height: 2rem;
    }
    .tools {
      grid-area: tools;
      padding-inline-start: 0;
      border: 0;
    }
    nav {
      grid-area: nav;
      justify-content: space-between;
      margin-inline: -0.6rem;
      overflow-x: auto;
      scrollbar-width: none;
    }
  }
</style>
