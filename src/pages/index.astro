---
// Farsi is the default language: the root always sends visitors to /fa/.
// English stays one click away through the language switch.
import { href } from '../lib/url';

const en = href('/en/');
const fa = href('/fa/');
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>expertochange</title>
    <link rel="canonical" href={fa} />
    <link rel="alternate" hreflang="fa" href={fa} />
    <link rel="alternate" hreflang="en" href={en} />
    <link rel="alternate" hreflang="x-default" href={fa} />
    <meta http-equiv="refresh" content={`0; url=${fa}`} />
    <script is:inline define:vars={{ fa }}>
      location.replace(fa);
    </script>
  </head>
  <body>
    <p><a href={fa} lang="fa">فارسی</a> · <a href={en} lang="en">English</a></p>
  </body>
</html>
