---
import { render } from 'astro:content';
import Article from '../../../layouts/Article.astro';
import { entryPaths } from '../../../lib/content';
import type { Lang } from '../../../i18n/ui';

export const getStaticPaths = () => entryPaths('portfolio');

const { entry, hasTranslation } = Astro.props;
const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const { Content } = await render(entry);
const d = entry.data;
---

<Article lang={lang} section="portfolio" slug={slug} title={d.title} summary={d.summary} date={d.date} hasTranslation={hasTranslation}>
  <p slot="before"><span class="pill">{d.role} · {d.organization} · {d.period}</span></p>
  <Content />
</Article>
