---
import Base from '../../../layouts/Base.astro';
import EntryList from '../../../components/EntryList.astro';
import SectionPhoto from '../../../components/SectionPhoto.astro';
import { langs, t, type Lang } from '../../../i18n/ui';
import { getEntries } from '../../../lib/content';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const entries = await getEntries('memories', lang);
---

<Base lang={lang} title={t(lang, 'memories.title')} altPath="/memories/">
  <SectionPhoto section="memories" variant="banner" />
  <header class="page-head">
    <h1>{t(lang, 'memories.title')}</h1>
    <p class="lead">{t(lang, 'memories.lead')}</p>
  </header>
  <EntryList lang={lang} section="memories" entries={entries} />
</Base>
