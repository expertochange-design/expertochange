---
import Base from '../../layouts/Base.astro';
import SectionPhoto from '../../components/SectionPhoto.astro';
import { href } from '../../lib/url';
import { formatNumber, langs, t, type Lang } from '../../i18n/ui';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const sections = [
  { key: 'portfolio' as const, href: href(`/${lang}/portfolio/`), title: t(lang, 'portfolio.title'), text: t(lang, 'home.portfolio') },
  { key: 'books' as const, href: href(`/${lang}/books/`), title: t(lang, 'books.title'), text: t(lang, 'home.books') },
  { key: 'memories' as const, href: href(`/${lang}/memories/`), title: t(lang, 'memories.title'), text: t(lang, 'home.memories') },
];
const num = (i: number) => (lang === 'fa' ? formatNumber(lang, i + 1) : String(i + 1).padStart(2, '0'));
---

<Base lang={lang} altPath="/">
  <section class="hero">
    <h1>{t(lang, 'site.tagline')}</h1>
    <p class="lead">{t(lang, 'home.intro')}</p>
  </section>
  <ul class="entries sections">
    {sections.map((s, i) => (
      <li>
        <a class="entry" href={s.href}>
          <span class="meta">{num(i)}</span>
          <span>
            <h2>{s.title}</h2>
            <p>{s.text}</p>
          </span>
          <SectionPhoto section={s.key} variant="thumb" />
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .hero {
    padding-block: 1.5rem 4rem;
    border-bottom: 1px solid var(--rule);
  }
  .hero h1 {
    max-width: 18ch;
    margin-block-end: 1.5rem;
  }
  :global(html[lang='fa']) .hero h1 {
    max-width: 22ch;
  }
  .sections .meta {
    font-family: var(--serif);
    font-size: 1rem;
    font-style: italic;
    letter-spacing: 0;
    text-transform: none;
    color: var(--accent);
  }
  .sections h2 {
    font-size: 1.75rem;
  }
  .sections .entry {
    grid-template-columns: 9rem 1fr 14rem;
    align-items: start;
  }
  .sections .entry :global(.soft-photo) {
    transition: opacity 0.2s;
  }
  .sections .entry:hover :global(.soft-photo) {
    opacity: 0.9;
  }
  @media (max-width: 640px) {
    .sections .entry {
      grid-template-columns: 1fr;
    }
    .sections .entry :global(.soft-photo) {
      order: -1;
      margin-block-end: 0.75rem;
    }
  }
</style>
