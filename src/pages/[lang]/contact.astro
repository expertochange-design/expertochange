---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import portrait from '../../assets/contact-portrait.jpg';
import { booking } from '../../lib/booking';
import { formatNumber, langs, type Lang } from '../../i18n/ui';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const n = (x: number) => formatNumber(lang, x);

const copy = {
  en: {
    title: 'Contact me',
    portraitAlt: 'Portrait of the author in a tweed jacket at her desk, holding a pen',
    intro:
      'expertochange stands for expert exchange: a place to share what I have learned so it can be useful to someone else.',
    about:
      'I started expertochange to share three things: what I have learned in my career, the books that changed how I think, and the experiences that shaped me. Everything here is written in English and Farsi, so the Persian community can read it in its own language.',
    book: 'Book a call',
    lead: 'Pick the call that fits. You choose a time on my calendar and get an invite by email.',
    write: 'Or write to me',
    minutes: 'minutes',
    soon: 'Booking opens soon',
    person: {
      label: 'For individuals',
      price: 'Free',
      name: 'A short talk',
      text: 'A quick question about your career, a book, or something I wrote. Come with one clear question and we will make the most of ten minutes.',
      cta: 'Book 10 minutes',
    },
    company: {
      label: 'For companies',
      price: 'On request',
      name: 'A working session',
      text: 'For companies with a specific project, role, or partnership to discuss. Tell me a little about it when you book. I confirm requests that are a good fit.',
      criteria: ['A clear topic or goal for the call', 'Someone who can decide on next steps joins', 'Work related to my experience'],
      cta: 'Request 30 minutes',
    },
  },
  fa: {
    title: 'تماس با من',
    portraitAlt: 'پرتره نویسنده با کت توید پشت میز کار، با قلمی در دست',
    intro:
      'expertochange یعنی «تبادل تخصص»: جایی برای به اشتراک گذاشتن آنچه آموخته‌ام تا به کار کس دیگری بیاید.',
    about:
      'expertochange را راه انداختم تا سه چیز را به اشتراک بگذارم: آنچه در مسیر کاری‌ام آموختم، کتاب‌هایی که نگاهم را تغییر دادند و تجربه‌هایی که مرا ساختند. همه مطالب این سایت به انگلیسی و فارسی نوشته می‌شود تا جامعه فارسی‌زبان هم بتواند آن‌ها را به زبان خودش بخواند.',
    book: 'رزرو گفتگو',
    write: 'یا برایم بنویسید',
    lead: 'گفتگوی مناسب خود را انتخاب کنید. زمانی را در تقویم من انتخاب می‌کنید و دعوت‌نامه با ایمیل برایتان می‌آید.',
    minutes: 'دقیقه',
    soon: 'رزرو به‌زودی باز می‌شود',
    person: {
      label: 'برای افراد',
      price: 'رایگان',
      name: 'یک گفتگوی کوتاه',
      text: 'یک سؤال کوتاه درباره مسیر کاری، یک کتاب یا نوشته‌ای از من. با یک سؤال روشن بیایید تا از این ده دقیقه بیشترین استفاده را ببریم.',
      cta: 'رزرو ۱۰ دقیقه',
    },
    company: {
      label: 'برای شرکت‌ها',
      price: 'با درخواست',
      name: 'یک جلسه کاری',
      text: 'برای شرکت‌هایی که پروژه، موقعیت شغلی یا همکاری مشخصی برای گفتگو دارند. هنگام رزرو کمی درباره آن بنویسید. درخواست‌هایی را که مناسب باشند تأیید می‌کنم.',
      criteria: ['موضوع یا هدف روشن برای جلسه', 'حضور کسی که درباره قدم‌های بعدی تصمیم می‌گیرد', 'کاری مرتبط با تجربه من'],
      cta: 'درخواست ۳۰ دقیقه',
    },
  },
}[lang];

const email = 'expertochange@gmail.com';

const options = [
  { ...copy.person, minutes: 10, url: booking.person },
  { ...copy.company, minutes: 30, url: booking.company },
];
---

<Base lang={lang} title={copy.title} altPath="/contact/">
  <header class="page-head intro-grid">
    <div class="prose">
      <h1>{copy.title}</h1>
      <p class="lead">{copy.intro}</p>
      <p>{copy.about}</p>
    </div>
    <Image class="portrait" src={portrait} alt={copy.portraitAlt} widths={[280, 560]} sizes="(max-width: 720px) 60vw, 280px" />
  </header>

  <section class="book">
    <h2>{copy.book}</h2>
    <p class="lead">{copy.lead}</p>
  </section>

  <ul class="options">
    {options.map((o) => (
      <li class="option">
        <p class="eyebrow">{o.label}</p>
        <p class="length">
          <span class="num">{n(o.minutes)}</span> {copy.minutes}
          <span class="price">&nbsp;· {o.price}</span>
        </p>
        <h2>{o.name}</h2>
        <p>{o.text}</p>
        {'criteria' in o && (
          <ul class="criteria">
            {(o.criteria as string[]).map((c) => <li>{c}</li>)}
          </ul>
        )}
        {o.url ? (
          <a class="cta" href={o.url} target="_blank" rel="noopener">{o.cta}</a>
        ) : (
          <span class="cta disabled" aria-disabled="true">{copy.soon}</span>
        )}
      </li>
    ))}
  </ul>

  <section class="write">
    <h2>{copy.write}</h2>
    <p><a href={`mailto:${email}`} dir="ltr">{email}</a></p>
  </section>
</Base>

<style>
  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15rem;
    gap: 2rem 3rem;
    align-items: start;
  }
  .intro-grid :global(.portrait) {
    width: 100%;
    height: auto;
    border-radius: 2px;
  }
  @media (max-width: 720px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }
    .intro-grid :global(.portrait) {
      order: -1;
      width: min(16rem, 70%);
    }
  }
  .page-head {
    margin-block-end: 3.5rem;
  }
  .book {
    margin-block-end: 2rem;
  }
  .book h2,
  .write h2 {
    margin-block-start: 0;
  }
  .write {
    margin-block-start: 3.5rem;
  }
  .options {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.5rem;
  }
  .option {
    display: flex;
    flex-direction: column;
    padding: 2rem 1.75rem;
    border: 1px solid var(--rule);
    border-top: 2px solid var(--accent);
    background: var(--paper-raised);
  }
  .option .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--accent);
  }
  .length {
    margin: 0;
    color: var(--ink-soft);
  }
  .num {
    font-size: 2.6rem;
    line-height: 1;
    color: var(--ink);
  }
  .price {
    color: var(--muted);
  }
  .option h2 {
    margin-block: 1rem 0.5rem;
    font-size: 1.35rem;
  }
  .option p {
    margin-block: 0 1rem;
  }
  .criteria {
    margin: 0 0 1rem;
    padding-inline-start: 1.1rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .cta {
    margin-block-start: auto;
    align-self: flex-start;
    padding: 0.7rem 1.3rem;
    border: 1px solid var(--accent);
    border-radius: 2px;
    background: var(--accent);
    color: var(--paper);
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
  }
  .cta:hover {
    border-color: var(--saffron);
    background: var(--saffron);
    color: #1f1c18;
  }
  .cta.disabled {
    background: none;
    color: var(--muted);
    border-color: var(--rule-strong);
  }
  :global(html[lang='fa']) .cta {
    font-family: var(--farsi);
    font-size: 0.95rem;
    letter-spacing: 0;
  }
</style>
