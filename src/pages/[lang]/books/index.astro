---
import Base from '../../../layouts/Base.astro';
import EntryList from '../../../components/EntryList.astro';
import { langs, t, type Lang } from '../../../i18n/ui';
import { getEntries } from '../../../lib/content';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const entries = await getEntries('books', lang);
const stars = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);
---

<Base lang={lang} title={t(lang, 'books.title')} altPath="/books/">
  <h1>{t(lang, 'books.title')}</h1>
  <p class="lead">{t(lang, 'books.lead')}</p>
  <EntryList lang={lang} section="books" entries={entries} kicker={(e) => `${e.data.author} · ${stars(e.data.rating)}`} />
</Base>
