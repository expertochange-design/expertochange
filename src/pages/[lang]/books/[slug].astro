---
import { render } from 'astro:content';
import Article from '../../../layouts/Article.astro';
import { entryPaths } from '../../../lib/content';
import { formatNumber, t, type Lang } from '../../../i18n/ui';

export const getStaticPaths = () => entryPaths('books');

const { entry, hasTranslation } = Astro.props;
const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const { Content } = await render(entry);
const d = entry.data;
---

<Article lang={lang} section="books" slug={slug} title={d.title} summary={d.summary} date={d.date} hasTranslation={hasTranslation}>
  <div slot="before" class="facts">
    <p class="meta">{d.author}</p>
    <p>
      <strong>{t(lang, 'books.rating')}:</strong>{' '}
      <span aria-hidden="true">{'★'.repeat(d.rating)}{'☆'.repeat(5 - d.rating)}</span>{' '}
      <span>({formatNumber(lang, d.rating)} / {formatNumber(lang, 5)})</span>
    </p>
    <h2>{t(lang, 'books.takeaways')}</h2>
    <ol>{d.takeaways.map((x) => <li>{x}</li>)}</ol>
    <h2>{t(lang, 'books.recommendedFor')}</h2>
    <p>{d.recommendedFor}</p>
  </div>
  <Content />
</Article>
